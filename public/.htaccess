Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical clean URLs
  RewriteRule ^products/([a-z0-9-]+)/?$ product.php?slug=$1 [L,QSA]
  RewriteRule ^category/([a-z0-9-]+)/?$ shop.php?category=$1 [L,QSA]
  RewriteRule ^pages/([a-z0-9-]+)/?$ page.php?slug=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Protect dotfiles and backups
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(bak|sql|log|ini|env)$">
  Require all denied
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
