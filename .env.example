# Copy to .env and fill in. Never commit .env.
APP_ENV=production
APP_DEBUG=0
APP_URL=https://dailydoseexport.com
APP_TIMEZONE=Asia/Kolkata

DB_HOST=localhost
DB_PORT=3306
DB_NAME=dailydose
DB_USER=
DB_PASS=

# log | mail | smtp  (log writes to storage/logs/mail.log and sends nothing)
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=tls
MAIL_FROM=care@dailydoseexport.com
MAIL_FROM_NAME=Daily Dose Export

# Razorpay (leave blank to disable online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
